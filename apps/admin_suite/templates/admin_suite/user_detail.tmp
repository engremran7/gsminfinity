{% extends "admin_suite/base.html" %}

{% block title %}Admin Suite - User{% endblock %}

{% block content %}
<div class="space-y-6">
  <div class="border rounded-lg bg-white shadow-sm p-4">
    <div class="flex items-center justify_between mb-2">
      <div>
        <div class="text-lg font-semibold text-slate-900">{{ user_obj.email }}</div>
        <p class="text-xs text-slate-500">User profile with devices, risk, and linked accounts.</p>
      </div>
      <div class="text-xs text-slate-500 bg-slate-100 px-2 py-1 rounded">ID: {{ user_obj.id }}</div>
    </div>
    {% if message %}
    <div class="text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 px-3 py-2 rounded mb-2">
      {{ message }}
    </div>
    {% endif %}
    <dl class="text-sm text-slate-700 space-y-1">
      <div class="flex justify-between"><dt>Staff</dt><dd>{{ user_obj.is_staff|yesno:"Yes,No" }}</dd></div>
      <div class="flex justify-between"><dt>Active</dt><dd>{{ user_obj.is_active|yesno:"Yes,No" }}</dd></div>
      <div class="flex justify-between"><dt>Joined</dt><dd>{{ user_obj.date_joined }}</dd></div>
      <div class="flex justify-between"><dt>Last login</dt><dd>{{ user_obj.last_login|default:"-" }}</dd></div>
    </dl>
    <div class="mt-3 flex gap-2 text-sm">
      <form method="post" class="inline">
        {% csrf_token %}
        <input type="hidden" name="action" value="toggle_staff">
        <button type="submit" class="px-3 py-1 rounded border border-slate-200 bg-white hover:bg-slate-50" title="Toggle staff privileges">
          {% if user_obj.is_staff %}Remove staff{% else %}Make staff{% endif %}
        </button>
      </form>
      <form method="post" class="inline">
        {% csrf_token %}
        <input type="hidden" name="action" value="toggle_active">
        <button type="submit" class="px-3 py-1 rounded border border-slate-200 bg-white hover:bg-slate-50" title="Toggle active state">
          {% if user_obj.is_active %}Deactivate{% else %}Activate{% endif %}
        </button>
      </form>
      <form method="post" class="inline">
        {% csrf_token %}
        <input type="hidden" name="action" value="force_verify_email">
        <input type="hidden" name="email" value="{{ user_obj.email }}">
        <button type="submit" class="px-3 py-1 rounded border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100" title="Mark primary email as verified">
          Force verify email
        </button>
      </form>
      <form method="post" class="inline">
        {% csrf_token %}
        <input type="hidden" name="action" value="send_password_reset">
        <button type="submit" class="px-3 py-1 rounded border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Send password reset email via allauth">
          Send reset
        </button>
      </form>
      <form method="post" class="inline">
        {% csrf_token %}
        <input type="hidden" name="action" value="invalidate_sessions">
        <button type="submit" class="px-3 py-1 rounded border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Expire sessions; user must re-login">
          Invalidate sessions
        </button>
      </form>
      <form method="post" class="inline" onsubmit="return confirm('Ban user? This sets the account inactive.');">
        {% csrf_token %}
        <input type="hidden" name="action" value="ban_user">
        <button type="submit" class="px-3 py-1 rounded border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100" title="Ban user (set inactive)">
          Ban user
        </button>
      </form>
      <form method="post" class="inline" onsubmit="return confirm('Soft-delete user? Email will be anonymized.');">
        {% csrf_token %}
        <input type="hidden" name="action" value="delete_user">
        <button type="submit" class="px-3 py-1 rounded border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100" title="Soft-delete and anonymize user">
          Delete (soft)
        </button>
      </form>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="border rounded-lg bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b flex items-center justify_between">
        <h2 class="text-lg font-semibold text-slate-900">Email addresses</h2>
        <span class="text-xs text-slate-500">allauth</span>
      </div>
      <div class="p-4 space-y-2 text-sm text-slate-700">
        {% if email_addresses %}
          {% for e in email_addresses %}
            <div class="flex items-center justify-between">
              <span>{{ e.email }}</span>
              <span class="text-xs text-slate-500">
                {% if e.primary %}Primary •{% endif %} {{ e.verified|yesno:"Verified,Unverified" }}
              </span>
            </div>
          {% endfor %}
        {% else %}
          <div class="text-slate-500 text-sm">No email addresses.</div>
        {% endif %}
      </div>
    </div>

    <div class="border rounded-lg bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b flex items-center justify_between">
        <h2 class="text-lg font-semibold text-slate-900">Social accounts</h2>
        <span class="text-xs text-slate-500">allauth</span>
      </div>
      <div class="p-4 space-y-2 text-sm text-slate-700">
        {% if social_accounts %}
          {% for s in social_accounts %}
            <div class="flex items-center justify-between">
              <span>{{ s.provider }} – {{ s.uid }}</span>
              <span class="text-xs text-slate-500">Last login: {{ s.last_login|default:"-" }}</span>
            </div>
          {% endfor %}
        {% else %}
          <div class="text-slate-500 text-sm">No social accounts linked.</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="border rounded-lg bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b">
        <h2 class="text-lg font-semibold text-slate-900">Devices</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
            <tr>
              <th class="px-4 py-2">Machine UUID</th>
              <th class="px-4 py-2">Blocked</th>
              <th class="px-4 py-2">Trusted</th>
              <th class="px-4 py-2">Last seen</th>
              <th class="px-4 py-2">Risk</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm text-slate-800">
            {% for d in devices %}
            <tr>
              <td class="px-4 py-2">{{ d.machine_uuid }}</td>
              <td class="px-4 py-2">{{ d.is_blocked|yesno:"Yes,No" }}</td>
              <td class="px-4 py-2">{{ d.is_trusted|yesno:"Yes,No" }}</td>
              <td class="px-4 py-2">{{ d.last_seen_at }}</td>
              <td class="px-4 py-2">{{ d.risk_score }}</td>
            </tr>
            {% empty %}
            <tr><td colspan="5" class="px-4 py-3 text-slate-500">No devices.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="border rounded-lg bg-white shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b">
        <h2 class="text-lg font-semibold text-slate-900">Risk insights</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
            <tr>
              <th class="px-4 py-2">Severity</th>
              <th class="px-4 py-2">Status</th>
              <th class="px-4 py-2">Device</th>
              <th class="px-4 py-2">At</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm text-slate-800">
            {% for r in risk_insights %}
            <tr>
              <td class="px-4 py-2 capitalize">{{ r.severity }}</td>
              <td class="px-4 py-2 capitalize">{{ r.status }}</td>
              <td class="px-4 py-2">{{ r.device_identifier|default:"-" }}</td>
              <td class="px-4 py-2">{{ r.created_at }}</td>
            </tr>
            {% empty %}
            <tr><td colspan="4" class="px-4 py-3 text-slate-500">No insights.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="border rounded-lg bg-white shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b">
      <h2 class="text-lg font-semibold text-slate-900">Recent device events</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
          <tr>
            <th class="px-4 py-2">Type</th>
            <th class="px-4 py-2">Success</th>
            <th class="px-4 py-2">Reason</th>
            <th class="px-4 py-2">At</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-800">
          {% for e in device_events %}
          <tr>
            <td class="px-4 py-2">{{ e.event_type }}</td>
            <td class="px-4 py-2">{{ e.success|yesno:"Yes,No" }}</td>
            <td class="px-4 py-2">{{ e.reason|default:"-" }}</td>
            <td class="px-4 py-2">{{ e.created_at }}</td>
          </tr>
          {% empty %}
          <tr><td colspan="4" class="px-4 py-3 text-slate-500">No events.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
